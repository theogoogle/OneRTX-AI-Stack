<Configuration>
  <VGpu>Enable</VGpu>
  <Networking>Enable</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>..</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\OneRTX-AI-Stack</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
